{
  "name": "segueo",
  "productName": "Segueo",
  "version": "1.6.0",
  "description": "Software DJ con AI DJ che mixa in automatico (anche con LLM locale): 2 deck, mixer, effetti, sampler, microfono, ingressi linea, MIDI, registrazione.",
  "main": "src/main/main.js",
  "author": "basoxxx",
  "license": "MIT",
  "homepage": "https://github.com/basoxxx/Virtual-Dj-Ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/basoxxx/Virtual-Dj-Ai.git"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test \"test/**/*.test.js\"",
    "check": "node scripts/check-syntax.js",
    "postinstall": "node scripts/vendor-ort.js",
    "models": "node scripts/download-models.js",
    "icons": "node scripts/generate-icon.js",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win msi --publish never",
    "dist:mac": "electron-builder --mac dmg --publish never",
    "dist:linux": "electron-builder --linux AppImage --publish never"
  },
  "dependencies": {
    "music-metadata": "^12.2.3"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "onnxruntime-web": "1.30.0"
  }
}
